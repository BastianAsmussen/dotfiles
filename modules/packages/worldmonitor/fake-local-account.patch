diff --git a/src/styles/main.css b/src/styles/main.css
index 7ff63ce..e6950b5 100644
--- a/src/styles/main.css
+++ b/src/styles/main.css
@@ -28646,3 +28646,26 @@ body.map-width-resizing {
   align-self: flex-start;
 }
 .pro-preview__reopen:hover, .pro-preview__reopen:focus-visible { opacity: 1; }
+
+/* ============================================================
+   Self-hosted build: no Clerk, no Convex, no Dodo.
+
+   The header account chrome mounts a Clerk UserButton that can
+   never load, so it renders an empty avatar slot — hide it; the
+   gear opens the same settings. The PRO badges label features
+   this instance already grants, so they advertise an upgrade
+   with nowhere to go.
+
+   Hidden in CSS rather than deleted in TS so every component
+   keeps compiling against upstream types and the next rev bump
+   does not fight a structural patch.
+   ============================================================ */
+.auth-widget-mount,
+.auth-header-widget,
+.mobile-menu-account,
+.mobile-menu-account + .mobile-menu-divider,
+.panel-pro-badge,
+.panel-toggle-pro-badge,
+.widget-pro-badge {
+  display: none !important;
+}
