diff --git a/components/settings/mcp-section.tsx b/components/settings/mcp-section.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9a5e0878ff167b11d19f7cddbf7edeea8650a268
--- /dev/null
+++ b/components/settings/mcp-section.tsx
@@ -0,0 +1,252 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import type { McpCredentialSettings, McpServerSettings, McpSettings } from "@/src/core";
+import { SettingsGroup, ThinSelect, Toggle } from "./controls.tsx";
+
+interface CredentialRow {
+	name: string;
+	value: string;
+	saved: boolean;
+}
+
+interface CredentialPatch {
+	headers: Record<string, string | null>;
+	env: Record<string, string | null>;
+}
+
+/** Only changed values cross the browser boundary. Blank saved values mean
+ * keep; omitted originals are explicitly deleted with null. */
+export function mcpCredentialPatch(rows: CredentialRow[], originalNames: string[]): CredentialPatch {
+	const patch: CredentialPatch = { headers: {}, env: {} };
+	for (const name of originalNames) patch.headers[name] = null;
+	for (const row of rows) {
+		const name = row.name.trim();
+		if (!name) continue;
+		if (!row.saved || row.value !== "") patch.headers[name] = row.value;
+		else if (originalNames.includes(name)) delete patch.headers[name];
+	}
+	return patch;
+}
+
+const inputClass = "w-full rounded-sm border border-border bg-background px-2 py-1.5 font-ui text-xs text-foreground outline-none focus:border-muted-foreground/50";
+const emptyServer = (): McpServerSettings => ({
+	id: crypto.randomUUID(),
+	name: "",
+	enabled: true,
+	transport: "http",
+	url: "",
+});
+
+function ServerEditor({
+	initial,
+	onCancel,
+	onSave,
+}: {
+	initial: McpServerSettings | null;
+	onCancel: () => void;
+	onSave: (server: McpServerSettings, patch: CredentialPatch) => Promise<void>;
+}) {
+	const [server, setServer] = useState<McpServerSettings>(() => initial ?? emptyServer());
+	const [argsText, setArgsText] = useState(initial?.args?.join("\n") ?? "");
+	const [rows, setRows] = useState<CredentialRow[]>([]);
+	const [originalNames, setOriginalNames] = useState<string[]>([]);
+	const [loading, setLoading] = useState(Boolean(initial));
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	const credentialKind = server.transport === "http" ? "headers" : "env";
+
+	useEffect(() => {
+		if (!initial) return;
+		let live = true;
+		fetch(`/api/mcp/credentials/${encodeURIComponent(initial.id)}`)
+			.then(async (response) => {
+				const body = await response.json() as { headers?: string[]; env?: string[]; error?: string };
+				if (!response.ok) throw new Error(body.error ?? `status ${response.status}`);
+				if (!live) return;
+				const names = server.transport === "http" ? body.headers ?? [] : body.env ?? [];
+				setOriginalNames(names);
+				setRows(names.map((name) => ({ name, value: "", saved: true })));
+				setLoading(false);
+			})
+			.catch((error: unknown) => {
+				if (live) setError(error instanceof Error ? error.message : "Could not load credentials");
+				if (live) setLoading(false);
+			});
+		return () => { live = false; };
+		// The editor is remounted by id; transport changes must not reload secrets.
+	}, [initial?.id]);
+
+	const update = (patch: Partial<McpServerSettings>) => setServer((current) => ({ ...current, ...patch }));
+	const updateRow = (index: number, patch: Partial<CredentialRow>) => setRows((current) => current.map((row, i) => i === index ? { ...row, ...patch } : row));
+	const save = async () => {
+		setSaving(true);
+		setError(null);
+		const next: McpServerSettings = server.transport === "http"
+			? { id: server.id, name: server.name.trim(), enabled: server.enabled, transport: "http", url: server.url?.trim() ?? "" }
+			: {
+				id: server.id,
+				name: server.name.trim(),
+				enabled: server.enabled,
+				transport: "stdio",
+				command: server.command?.trim() ?? "",
+				args: argsText.split("\n").map((arg) => arg.replace(/\r$/, "")).filter((arg) => arg.length > 0),
+				...(server.cwd?.trim() ? { cwd: server.cwd.trim() } : {}),
+			};
+		const currentNames = new Set(rows.map((row) => row.name.trim()).filter(Boolean));
+		const normalizedNames = server.transport === "http" ? [...currentNames].map((name) => name.toLowerCase()) : [...currentNames];
+		if (new Set(normalizedNames).size !== normalizedNames.length) {
+			setError("Credential names must be unique.");
+			setSaving(false);
+			return;
+		}
+		const patch = mcpCredentialPatch(rows, originalNames);
+		try {
+			await onSave(next, server.transport === "http" ? patch : { headers: {}, env: patch.headers });
+		} catch (cause) {
+			setError(cause instanceof Error ? cause.message : "Could not save MCP server");
+			setSaving(false);
+		}
+	};
+
+	return (
+		<div className="space-y-3 rounded-md border border-border p-4" data-testid="mcp-editor">
+			<div className="grid gap-3 sm:grid-cols-2">
+				<label className="text-xs text-muted-foreground">Name
+					<input aria-label="MCP server name" className={`${inputClass} mt-1`} value={server.name} onChange={(event) => update({ name: event.target.value })} placeholder="Covenant of Earth" />
+				</label>
+				<label className="text-xs text-muted-foreground">Transport
+					<ThinSelect ariaLabel="MCP transport" value={server.transport} onChange={(transport) => update({
+						transport: transport as McpServerSettings["transport"],
+						...(transport === "http" ? { url: server.url ?? "" } : { command: server.command ?? "" }),
+					})}>
+						<option value="http">Streamable HTTP</option>
+						<option value="stdio">stdio</option>
+					</ThinSelect>
+				</label>
+			</div>
+			{server.transport === "http" ? (
+				<label className="block text-xs text-muted-foreground">Endpoint URL
+					<input aria-label="MCP endpoint URL" className={`${inputClass} mt-1`} value={server.url ?? ""} onChange={(event) => update({ url: event.target.value })} placeholder="https://covenantofearth.org/mcp" />
+				</label>
+			) : (
+				<>
+					<label className="block text-xs text-muted-foreground">Command
+						<input aria-label="MCP command" className={`${inputClass} mt-1`} value={server.command ?? ""} onChange={(event) => update({ command: event.target.value })} placeholder="node" />
+					</label>
+					<label className="block text-xs text-muted-foreground">Arguments, one per line
+						<textarea aria-label="MCP arguments" className={`${inputClass} mt-1 min-h-16`} value={argsText} onChange={(event) => setArgsText(event.target.value)} placeholder="server.mjs" />
+					</label>
+					<label className="block text-xs text-muted-foreground">Working directory (optional)
+						<input aria-label="MCP working directory" className={`${inputClass} mt-1`} value={server.cwd ?? ""} onChange={(event) => update({ cwd: event.target.value })} />
+					</label>
+				</>
+			)}
+			<div className="space-y-2">
+				<div className="flex items-center justify-between">
+					<span className="text-xs text-muted-foreground">{credentialKind === "headers" ? "HTTP headers" : "Environment variables"}</span>
+					<Button type="button" size="xs" variant="outline" onClick={() => setRows((current) => [...current, { name: "", value: "", saved: false }])}>Add {credentialKind === "headers" ? "header" : "variable"}</Button>
+				</div>
+				{loading ? <p className="text-xs text-muted-foreground">Loading credential names…</p> : rows.map((row, index) => (
+					<div className="flex gap-2" key={`${index}-${row.saved}`}>
+						<input aria-label={`${credentialKind} name ${index + 1}`} className={inputClass} value={row.name} placeholder="Authorization" onChange={(event) => updateRow(index, { name: event.target.value })} />
+						<input aria-label={`${credentialKind} value ${index + 1}`} className={inputClass} type="password" value={row.value} placeholder={row.saved ? "Saved; leave blank to keep" : "Value"} onChange={(event) => updateRow(index, { value: event.target.value })} />
+						<Button type="button" size="xs" variant="outline" aria-label={`Remove ${credentialKind} row ${index + 1}`} onClick={() => setRows((current) => current.filter((_, i) => i !== index))}>Remove</Button>
+					</div>
+				))}
+				<p className="text-xs text-muted-foreground/70">Values stay in the private credential store and are never loaded back into this form.</p>
+			</div>
+			{error && <p role="alert" className="text-xs text-red-500">{error}</p>}
+			<div className="flex justify-end gap-2">
+				<Button type="button" size="xs" variant="outline" onClick={onCancel}>Cancel</Button>
+				<Button type="button" size="xs" disabled={saving || loading} onClick={() => void save()}>{saving ? "Saving…" : "Save server"}</Button>
+			</div>
+		</div>
+	);
+}
+
+export function McpSection({
+	mcp,
+	onSave,
+}: {
+	mcp?: McpSettings;
+	onSave: (next: McpSettings) => Promise<boolean>;
+}) {
+	const servers = mcp?.servers ?? [];
+	const [editing, setEditing] = useState<string | "new" | null>(null);
+	const [error, setError] = useState<string | null>(null);
+	const [statuses, setStatuses] = useState<Record<string, string>>({});
+	const [testing, setTesting] = useState<string | null>(null);
+	const serverBeingEdited = editing && editing !== "new" ? servers.find((server) => server.id === editing) ?? null : null;
+
+	const saveServers = async (next: McpServerSettings[]) => {
+		setError(null);
+		const saved = await onSave({ servers: next });
+		if (!saved) setError("The server configuration could not be saved.");
+		return saved;
+	};
+	const saveServer = async (server: McpServerSettings, patch: CredentialPatch) => {
+		const next = servers.some((candidate) => candidate.id === server.id)
+			? servers.map((candidate) => candidate.id === server.id ? server : candidate)
+			: [...servers, server];
+		if (!await saveServers(next)) throw new Error("The server configuration could not be saved.");
+		const response = await fetch(`/api/mcp/credentials/${encodeURIComponent(server.id)}`, {
+			method: "PUT",
+			headers: { "content-type": "application/json" },
+			body: JSON.stringify(patch),
+		});
+		const body = await response.json() as { error?: string };
+		if (!response.ok) throw new Error(body.error ?? "The server was saved, but its credentials were not.");
+		setEditing(null);
+	};
+	const test = async (server: McpServerSettings) => {
+		setTesting(server.id);
+		setStatuses((current) => ({ ...current, [server.id]: "Testing…" }));
+		try {
+			const response = await fetch(`/api/mcp/test/${encodeURIComponent(server.id)}`, { method: "POST" });
+			const body = await response.json() as { error?: string; server?: { tools: number; resources: number; resourceTemplates: number; prompts: number } };
+			if (!response.ok || !body.server) throw new Error(body.error ?? `status ${response.status}`);
+			const summary = body.server;
+			setStatuses((current) => ({ ...current, [server.id]: `${summary.tools} tools · ${summary.resources} resources · ${summary.resourceTemplates} templates · ${summary.prompts} prompts` }));
+		} catch (cause) {
+			setStatuses((current) => ({ ...current, [server.id]: cause instanceof Error ? cause.message : "Connection failed" }));
+		} finally {
+			setTesting(null);
+		}
+	};
+
+	return (
+		<>
+			<p className="text-xs text-muted-foreground">Connect external MCP servers. Adding or enabling a server trusts its tools to run in probing, teaching, and practice.</p>
+			{error && <p role="alert" className="text-xs text-red-500">{error}</p>}
+			<SettingsGroup label="Servers" testid="mcp-server-list">
+				{servers.length === 0 && <p className="py-2 text-xs text-muted-foreground">No MCP servers configured.</p>}
+				{servers.map((server) => (
+					<div key={server.id} className="rounded-md border border-border/70 p-3" data-testid={`mcp-server-${server.id}`}>
+						<div className="flex items-center gap-3">
+							<div className="min-w-0 flex-1">
+								<p className="font-prose text-(length:--lh-prose-size)">{server.name}</p>
+								<p className="truncate text-xs text-muted-foreground">{server.transport === "http" ? server.url : [server.command, ...(server.args ?? [])].join(" ")}</p>
+							</div>
+							<Toggle checked={server.enabled} label={`Enable ${server.name}`} onChange={(enabled) => void saveServers(servers.map((candidate) => candidate.id === server.id ? { ...candidate, enabled } : candidate))} />
+						</div>
+						{statuses[server.id] && <p role="status" className="mt-2 text-xs text-muted-foreground">{statuses[server.id]}</p>}
+						<div className="mt-2 flex gap-2">
+							<Button type="button" size="xs" variant="outline" onClick={() => setEditing(server.id)}>Edit</Button>
+							<Button type="button" size="xs" variant="outline" disabled={testing !== null} onClick={() => void test(server)}>{testing === server.id ? "Testing…" : "Test connection"}</Button>
+							<Button type="button" size="xs" variant="outline" onClick={() => {
+								if (window.confirm(`Remove ${server.name} and its saved credentials?`)) void saveServers(servers.filter((candidate) => candidate.id !== server.id));
+							}}>Delete</Button>
+						</div>
+					</div>
+				))}
+				{editing === null ? (
+					<Button type="button" size="xs" variant="outline" className="self-start" data-testid="mcp-add" onClick={() => setEditing("new")}>Add MCP server</Button>
+				) : (
+					<ServerEditor key={editing} initial={editing === "new" ? null : serverBeingEdited} onCancel={() => setEditing(null)} onSave={saveServer} />
+				)}
+			</SettingsGroup>
+		</>
+	);
+}
