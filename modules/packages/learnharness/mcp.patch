+export function parseMcpSettingsBody(body: unknown): SettingsBodyResult<McpSettings> {
+	const raw = asRecord(body);
+	if (!raw) return { ok: false, error: "Invalid JSON body" };
+	if (raw.servers === undefined) return { ok: true, settings: {} };
+	if (!Array.isArray(raw.servers)) return { ok: false, error: "servers must be an array" };
+	const servers: McpServerSettings[] = [];
+	const ids = new Set<string>();
+	const names = new Set<string>();
+	for (const [index, entry] of raw.servers.entries()) {
+		const value = asRecord(entry);
+		if (!value) return { ok: false, error: `servers[${index}] must be an object` };
+		if (typeof value.id !== "string" || !MCP_SERVER_ID_PATTERN.test(value.id)) {
+			return { ok: false, error: `servers[${index}].id must be a stable 8–64 character id` };
+		}
+		if (typeof value.name !== "string" || !value.name.trim()) {
+			return { ok: false, error: `servers[${index}].name must be non-empty` };
+		}
+		if (value.enabled !== undefined && typeof value.enabled !== "boolean") {
+			return { ok: false, error: `servers[${index}].enabled must be a boolean` };
+		}
+		if (value.transport !== "stdio" && value.transport !== "http") {
+			return { ok: false, error: `servers[${index}].transport must be stdio or http` };
+		}
+		const normalized = normalizeMcpServerName(value.name);
+		if (ids.has(value.id) || names.has(normalized)) {
+			return { ok: false, error: "MCP server ids and normalized names must be unique" };
+		}
+		const server: McpServerSettings = {
+			id: value.id,
+			name: value.name.trim(),
+			enabled: value.enabled ?? true,
+			transport: value.transport,
+		};
+		if (value.transport === "stdio") {
+			if (value.url !== undefined) return { ok: false, error: `${server.name}: url is only valid for HTTP servers` };
+			if (typeof value.command !== "string" || !value.command.trim()) {
+				return { ok: false, error: `${server.name}: command must be non-empty` };
+			}
+			server.command = value.command.trim();
+			if (value.args !== undefined && (!Array.isArray(value.args) || value.args.some((arg) => typeof arg !== "string"))) {
+				return { ok: false, error: `${server.name}: args must be an array of strings` };
+			}
+			server.args = (value.args as string[] | undefined) ?? [];
+			if (value.cwd !== undefined) {
+				if (typeof value.cwd !== "string" || !value.cwd.trim()) return { ok: false, error: `${server.name}: cwd must be a non-empty string` };
+				server.cwd = value.cwd.trim();
+			}
+		} else {
+			if (value.command !== undefined || value.args !== undefined || value.cwd !== undefined) {
+				return { ok: false, error: `${server.name}: command, args and cwd are only valid for stdio servers` };
+			}
+			if (typeof value.url !== "string") return { ok: false, error: `${server.name}: url must be an absolute HTTP(S) URL` };
+			const url = normalizeMcpHttpUrl(value.url);
+			if (!url) return { ok: false, error: `${server.name}: url must be absolute HTTP(S) without embedded credentials` };
+			server.url = url;
+		}
+		ids.add(server.id);
+		names.add(normalized);
+		servers.push(server);
+	}
+	return { ok: true, settings: { servers } };
+}
