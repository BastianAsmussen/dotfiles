@@ -0,0 +1,42 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test, { after } from "node:test";
+
+const TMP = fs.mkdtempSync(path.join(os.tmpdir(), "lh-mcp-auth-"));
+process.env.LH_AUTH_FILE = path.join(TMP, "auth.json");
+const auth = await import("../src/store/auth.ts");
+const { AUTH_FILE } = await import("../config.ts");
+
+after(() => fs.rmSync(TMP, { recursive: true, force: true }));
+
+test("MCP credentials round-trip privately by stable server id", () => {
+	auth.authStore.setAuthVar("EXISTING_KEY", "keep");
+	auth.writeMcpCredentials("server_one", { headers: { Authorization: "Bearer secret" } });
+	auth.writeMcpCredentials("server_two", { env: { API_KEY: "also-secret" } });
+	assert.deepEqual(auth.readMcpCredentials(), {
+		server_one: { headers: { Authorization: "Bearer secret" } },
+		server_two: { env: { API_KEY: "also-secret" } },
+	});
+	assert.equal(auth.authStore.authVars().EXISTING_KEY, "keep");
+	assert.equal(fs.statSync(AUTH_FILE).mode & 0o777, 0o600);
+});
+
+test("empty credentials and server deletion remove only the intended record", () => {
+	auth.writeMcpCredentials("server_one", {});
+	assert.deepEqual(auth.readMcpCredentials(), { server_two: { env: { API_KEY: "also-secret" } } });
+	auth.deleteMcpCredentials(["server_two"]);
+	assert.deepEqual(auth.readMcpCredentials(), {});
+	assert.equal(auth.authStore.authVars().EXISTING_KEY, "keep");
+	assert.throws(() => auth.authStore.setAuthVar(auth.MCP_CREDENTIALS_AUTH_KEY, "not allowed"), /MCP credential editor/);
+});
+
+test("corrupt MCP credentials fail closed instead of being overwritten", () => {
+	const raw = JSON.parse(fs.readFileSync(AUTH_FILE, "utf8")) as Record<string, unknown>;
+	raw[auth.MCP_CREDENTIALS_AUTH_KEY] = "not json";
+	fs.writeFileSync(AUTH_FILE, JSON.stringify(raw), { mode: 0o600 });
+	assert.throws(() => auth.readMcpCredentials(), /Invalid MCP credential record/);
+	assert.throws(() => auth.writeMcpCredentials("server_three", { env: { KEY: "value" } }), /Invalid MCP credential record/);
+	assert.equal(raw[auth.MCP_CREDENTIALS_AUTH_KEY], "not json");
+});
diff --git a/tests/mcp-client.test.ts b/tests/mcp-client.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..414004cf0cea6811ecb1cfdac6a0ecc61447c8f4
