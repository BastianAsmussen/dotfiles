+import type { McpServerSettings } from "../core/mcp.ts";
+import { connectMcpServers, type McpServerSummary } from "../agent/mcp.ts";
+import { readMcpCredentials } from "../store/auth.ts";
+import { effectiveSettings } from "./stores.ts";
+
+/** Compose a turn's MCP session from the current nonsecret settings snapshot
+ * and a fresh private credential read. */
+export function openMcpSession(servers: McpServerSettings[]) {
+	return connectMcpServers(servers, readMcpCredentials());
+}
+
+/** Explicitly testing a saved server also works while its runtime switch is
+ * disabled; only the discovery connection is forced on. */
+export async function testMcpServer(id: string): Promise<McpServerSummary> {
+	const server = effectiveSettings().mcp.servers.find((candidate) => candidate.id === id);
+	if (!server) throw new Error("Unknown MCP server");
+	const session = await openMcpSession([{ ...server, enabled: true }]);
+	try {
+		return session.summaries()[0]!;
+	} finally {
+		await session.close();
+	}
+}
