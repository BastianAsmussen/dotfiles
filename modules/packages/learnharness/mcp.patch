index 0000000000000000000000000000000000000000..fa91c1f8dbfe3a9b18b838f559de2fa303eecad5
--- /dev/null
+++ b/src/server/mcp-http.ts
@@ -0,0 +1,110 @@
+import type { McpCredentialSettings } from "../core/mcp.ts";
+import { McpConnectionError } from "../agent/mcp.ts";
+import { readMcpCredentials, writeMcpCredentials } from "../store/auth.ts";
+import { desktopAPIAuthorized } from "./desktop-access.ts";
+import { subscriptionRequestOrigin } from "./web-subscription-http.ts";
+import { CustomBodyLimitError, readBoundedJson } from "./custom-provider-body.ts";
+import { effectiveSettings } from "./stores.ts";
+import { testMcpServer } from "./mcp.ts";
+
+function response(body: object, status = 200): Response {
+	return Response.json(body, { status, headers: { "cache-control": "no-store" } });
+}
+
+function authorized(request: Request): boolean {
+	const desktop = process.env.LH_DESKTOP_SERVER === "1" || Boolean(process.env.LH_DESKTOP_API_SECRET);
+	if (desktop) return desktopAPIAuthorized(request.headers);
+	const origin = request.headers.get("origin");
+	if (!origin || origin === "null") return false;
+	try {
+		return origin === subscriptionRequestOrigin(request)
+			&& (!request.headers.has("sec-fetch-site") || request.headers.get("sec-fetch-site") === "same-origin");
+	} catch { return false; }
+}
+
+function credentialNames(credentials: McpCredentialSettings | undefined) {
+	return {
+		headers: Object.keys(credentials?.headers ?? {}),
+		env: Object.keys(credentials?.env ?? {}),
+	};
+}
+
+function serverExists(id: string): boolean {
+	return effectiveSettings().mcp.servers.some((server) => server.id === id);
+}
+
+export function mcpCredentialsGet(_request: Request, id: string): Response {
+	if (!serverExists(id)) return response({ error: "Unknown MCP server" }, 404);
+	try {
+		return response(credentialNames(readMcpCredentials()[id]));
+	} catch {
+		return response({ error: "MCP credential storage is unavailable." }, 500);
+	}
+}
+
+type CredentialPatch = Record<string, string | null>;
+
+function parsePatch(raw: unknown, field: string): { patch?: CredentialPatch; error?: string } {
+	if (raw === undefined) return { patch: {} };
+	if (raw === null || typeof raw !== "object" || Array.isArray(raw)) return { error: `${field} must be an object` };
+	const patch: CredentialPatch = {};
+	for (const [name, value] of Object.entries(raw)) {
+		if (!name || (typeof value !== "string" && value !== null)) return { error: `${field}.${name} must be a string or null to delete` };
+		if (name.includes("\0") || name.includes("=")) return { error: `${field} contains an invalid name` };
+		if (value !== null) {
+			try { new Headers({ [name]: value }); } catch { return { error: `${field} contains an invalid name or value` }; }
+		}
+		patch[name] = value;
+	}
+	return { patch };
+}
+
+/** Apply a credential patch. Omitted keys stay untouched; null explicitly
+ * deletes. The response contains names only, never credential values. */
+export async function mcpCredentialsPut(request: Request, id: string): Promise<Response> {
+	if (!authorized(request)) return response({ error: "MCP credentials require a trusted same-origin request." }, 403);
+	if (request.headers.get("content-type")?.split(";")[0]?.trim().toLowerCase() !== "application/json") {
+		return response({ error: "JSON content-type is required." }, 415);
+	}
+	const server = effectiveSettings().mcp.servers.find((candidate) => candidate.id === id);
+	if (!server) return response({ error: "Unknown MCP server" }, 404);
+	try {
+		const body = await readBoundedJson(request, 64 * 1024);
+		if (body === null || typeof body !== "object" || Array.isArray(body)) return response({ error: "Invalid JSON body" }, 400);
+		const raw = body as Record<string, unknown>;
+		const headers = parsePatch(raw.headers, "headers");
+		if (headers.error) return response({ error: headers.error }, 400);
+		const env = parsePatch(raw.env, "env");
+		if (env.error) return response({ error: env.error }, 400);
+		if (server.transport === "http" && Object.keys(env.patch!).length) return response({ error: "env is only valid for stdio servers" }, 400);
+		if (server.transport === "stdio" && Object.keys(headers.patch!).length) return response({ error: "headers are only valid for HTTP servers" }, 400);
+		const current = readMcpCredentials()[id] ?? {};
+		const next: McpCredentialSettings = {
+			headers: { ...current.headers },
+			env: { ...current.env },
+		};
+		for (const [name, value] of Object.entries(headers.patch!)) {
+			if (value === null) delete next.headers![name]; else next.headers![name] = value;
+		}
+		for (const [name, value] of Object.entries(env.patch!)) {
+			if (value === null) delete next.env![name]; else next.env![name] = value;
+		}
+		writeMcpCredentials(id, next);
+		return response({ ok: true, ...credentialNames(next) });
+	} catch (error) {
+		if (error instanceof CustomBodyLimitError) return response({ error: "Credential body exceeds 64 KiB." }, 413);
+		if (error instanceof SyntaxError) return response({ error: "Invalid JSON body." }, 400);
+		return response({ error: "Unable to save MCP credentials. No success was reported." }, 500);
+	}
+}
+
+export async function mcpTestPost(request: Request, id: string): Promise<Response> {
+	if (!authorized(request)) return response({ error: "MCP connection tests require a trusted same-origin request." }, 403);
+	if (!serverExists(id)) return response({ error: "Unknown MCP server" }, 404);
+	try {
+		return response({ ok: true, server: await testMcpServer(id) });
+	} catch (error) {
+		if (error instanceof McpConnectionError) return response({ error: error.message }, 502);
+		return response({ error: "MCP configuration or credentials could not be read." }, 500);
+	}
+}
