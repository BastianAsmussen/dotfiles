+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test, { after, before } from "node:test";
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lh-mcp-http-"));
+process.env.LH_DATA_DIR = dir;
+process.env.LH_AUTH_FILE = path.join(dir, "auth.json");
+let credentials: typeof import("../app/api/mcp/credentials/[id]/route.ts");
+let settings: typeof import("../app/api/settings/[section]/route.ts");
+let auth: typeof import("../src/store/auth.ts");
+
+before(async () => {
+	credentials = await import("../app/api/mcp/credentials/[id]/route.ts");
+	settings = await import("../app/api/settings/[section]/route.ts");
+	auth = await import("../src/store/auth.ts");
+	const store = await import("../src/store/settings.ts");
+	store.writeSettings({ version: 1, mcp: { servers: [{
+		id: "covenant_1", name: "Covenant", enabled: true, transport: "http", url: "https://covenantofearth.org/mcp",
+	}] } });
+});
+
+after(() => {
+	fs.rmSync(dir, { recursive: true, force: true });
+	delete process.env.LH_DATA_DIR;
+	delete process.env.LH_AUTH_FILE;
+});
+
+function put(body: unknown, origin = "http://localhost") {
+	return credentials.PUT(new Request("http://localhost/api/mcp/credentials/covenant_1", {
+		method: "PUT",
+		headers: { "content-type": "application/json", origin },
+		body: JSON.stringify(body),
+	}), { params: Promise.resolve({ id: "covenant_1" }) });
+}
+
+test("MCP credential routes patch values but return only names", async () => {
+	const denied = await put({ headers: { Authorization: "secret" } }, "https://attacker.invalid");
+	assert.equal(denied.status, 403);
+	const saved = await put({ headers: { Authorization: "secret", "X-Remove": "delete-me" } });
+	assert.equal(saved.status, 200);
+	assert.deepEqual(auth.readMcpCredentials().covenant_1, { headers: { Authorization: "secret", "X-Remove": "delete-me" } });
+	assert.deepEqual(await saved.json(), { ok: true, headers: ["Authorization", "X-Remove"], env: [] });
+	const response = await credentials.GET(new Request("http://localhost/api/mcp/credentials/covenant_1"), { params: Promise.resolve({ id: "covenant_1" }) });
+	const text = await response.text();
+	assert.ok(text.includes("Authorization"));
+	assert.ok(!text.includes("secret"));
+	assert.ok(!text.includes("delete-me"));
+	const updated = await put({ headers: { "X-Remove": null, "X-New": "new-secret" } });
+	assert.equal(updated.status, 200);
+	assert.deepEqual(auth.readMcpCredentials().covenant_1, { headers: { Authorization: "secret", "X-New": "new-secret" } });
+});
+
+test("deleting an MCP settings server deletes its credentials", async () => {
+	const response = await settings.PUT(new Request("http://localhost/api/settings/mcp", {
+		method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify({ servers: [] }),
+	}), { params: Promise.resolve({ section: "mcp" }) });
+	assert.equal(response.status, 200);
+	assert.deepEqual(auth.readMcpCredentials(), {});
+});
