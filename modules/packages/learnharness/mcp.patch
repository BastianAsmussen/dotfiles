+
+function parseCredentialMap(raw: unknown): Record<string, string> | undefined {
+	if (raw === undefined) return undefined;
+	if (raw === null || typeof raw !== "object" || Array.isArray(raw)) throw new Error("Invalid MCP credential record");
+	const entries = Object.entries(raw);
+	if (entries.some(([name, value]) => !name || typeof value !== "string")) throw new Error("Invalid MCP credential record");
+	return Object.fromEntries(entries) as Record<string, string>;
+}
+
+function parseMcpCredentials(raw: unknown): Record<string, McpCredentialSettings> {
+	if (raw === undefined) return {};
+	if (typeof raw !== "string") throw new Error("Invalid MCP credential record");
+	let parsed: unknown;
+	try { parsed = JSON.parse(raw); } catch { throw new Error("Invalid MCP credential record"); }
+	if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) throw new Error("Invalid MCP credential record");
+	const out: Record<string, McpCredentialSettings> = {};
+	for (const [id, value] of Object.entries(parsed)) {
+		if (!MCP_SERVER_ID_PATTERN.test(id) || value === null || typeof value !== "object" || Array.isArray(value)) {
+			throw new Error("Invalid MCP credential record");
+		}
+		const raw = value as Record<string, unknown>;
+		const headers = parseCredentialMap(raw.headers);
+		const env = parseCredentialMap(raw.env);
+		out[id] = { ...(headers ? { headers } : {}), ...(env ? { env } : {}) };
+	}
+	return out;
+}
+
+/** Read all MCP credentials for runtime injection. Callers must never serialize
+ * this return value into an HTTP response. */
+export function readMcpCredentials(): Record<string, McpCredentialSettings> {
+	return parseMcpCredentials(readCustomMap()[MCP_CREDENTIALS_AUTH_KEY]);
+}
+
+export function writeMcpCredentials(id: string, credentials: McpCredentialSettings): void {
+	if (!MCP_SERVER_ID_PATTERN.test(id)) throw new Error("Invalid MCP server id");
+	// Validate and clone before touching the private record.
+	const cleaned = parseMcpCredentials(JSON.stringify({ [id]: credentials }))[id]!;
+	const normalized: McpCredentialSettings = {
+		...(Object.keys(cleaned.headers ?? {}).length ? { headers: cleaned.headers } : {}),
+		...(Object.keys(cleaned.env ?? {}).length ? { env: cleaned.env } : {}),
+	};
+	const map = readCustomMap();
+	const all = parseMcpCredentials(map[MCP_CREDENTIALS_AUTH_KEY]);
+	if (Object.keys(normalized).length) all[id] = normalized;
+	else delete all[id];
+	if (Object.keys(all).length) map[MCP_CREDENTIALS_AUTH_KEY] = JSON.stringify(all);
+	else delete map[MCP_CREDENTIALS_AUTH_KEY];
+	writeMap(map);
+}
+
+export function deleteMcpCredentials(ids: Iterable<string>): void {
+	const map = readCustomMap();
+	const all = parseMcpCredentials(map[MCP_CREDENTIALS_AUTH_KEY]);
+	let changed = false;
+	for (const id of ids) changed = delete all[id] || changed;
+	if (!changed) return;
+	if (Object.keys(all).length) map[MCP_CREDENTIALS_AUTH_KEY] = JSON.stringify(all);
+	else delete map[MCP_CREDENTIALS_AUTH_KEY];
+	writeMap(map);
+}
