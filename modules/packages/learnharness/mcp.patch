+++ b/src/agent/mcp.ts
@@ -0,0 +1,360 @@
+import { createHash } from "node:crypto";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StdioClientTransport, getDefaultEnvironment } from "@modelcontextprotocol/sdk/client/stdio.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import type { Tool as McpTool } from "@modelcontextprotocol/sdk/types.js";
+import type { AgentTool, AgentToolResult } from "@earendil-works/pi-agent-core";
+import { Type, type TSchema } from "typebox";
+import type { McpCredentialSettings, McpServerSettings } from "../core/mcp.ts";
+import { normalizeMcpServerName } from "../core/mcp.ts";
+import { serverExecute } from "./tool-execute.ts";
+import { withArgumentHeal } from "./tools/heal.ts";
+
+export const MCP_CONNECT_TIMEOUT_MS = 10_000;
+export const MCP_REQUEST_TIMEOUT_MS = 30_000;
+const MAX_TOOL_NAME_LENGTH = 64;
+
+type McpRecord = Record<string, unknown>;
+type McpContent = { type?: string; [key: string]: unknown };
+
+export interface McpConnection {
+	server: McpServerSettings;
+	client: Client;
+	tools: McpTool[];
+	resourceCount: number;
+	resourceTemplateCount: number;
+	promptCount: number;
+}
+
+export interface McpServerSummary {
+	id: string;
+	name: string;
+	tools: number;
+	resources: number;
+	resourceTemplates: number;
+	prompts: number;
+}
+
+export interface McpSession {
+	tools: Record<string, AgentTool<any>>;
+	connections: McpConnection[];
+	summaries(): McpServerSummary[];
+	close(): Promise<void>;
+}
+
+export class McpConnectionError extends Error {
+	readonly serverName: string;
+	constructor(serverName: string, cause: unknown) {
+		const detail = cause instanceof Error ? cause.message : String(cause);
+		super(`MCP server "${serverName}" is unavailable: ${detail}`, { cause });
+		this.name = "McpConnectionError";
+		this.serverName = serverName;
+	}
+}
+
+function requestOptions(signal?: AbortSignal) {
+	return { signal, timeout: MCP_REQUEST_TIMEOUT_MS, maxTotalTimeout: MCP_REQUEST_TIMEOUT_MS };
+}
+
+function asRecord(value: unknown): McpRecord {
+	return value !== null && typeof value === "object" && !Array.isArray(value) ? value as McpRecord : {};
+}
+
+function text(text: string): { type: "text"; text: string } {
+	return { type: "text", text };
+}
+
+function json(value: unknown): string {
+	try { return JSON.stringify(value, null, 2) ?? String(value); }
+	catch { return String(value); }
+}
+
+/** Convert protocol content into Pi's native text/image channel. Audio has no
+ * Pi representation, so it gets an explicit model-visible notice instead of
+ * disappearing. Other structured content remains available as JSON text. */
+function convertContent(parts: unknown): AgentToolResult<unknown>["content"] {
+	if (!Array.isArray(parts)) return [];
+	const out: AgentToolResult<unknown>["content"] = [];
+	for (const value of parts) {
+		const part = asRecord(value) as McpContent;
+		if (part.type === "text" && typeof part.text === "string") {
+			out.push(text(part.text));
+		} else if (part.type === "image" && typeof part.data === "string" && typeof part.mimeType === "string") {
+			out.push({ type: "image", data: part.data, mimeType: part.mimeType });
+		} else if (part.type === "resource") {
+			const resource = asRecord(part.resource);
+			const label = `Embedded MCP resource${typeof resource.uri === "string" ? `: ${resource.uri}` : ""}`;
+			if (typeof resource.text === "string") {
+				out.push(text(`${label}\n${resource.text}`));
+			} else if (typeof resource.blob === "string" && typeof resource.mimeType === "string" && resource.mimeType.startsWith("image/")) {
+				out.push(text(label), { type: "image", data: resource.blob, mimeType: resource.mimeType });
+			} else {
+				out.push(text(json(part)));
+			}
+		} else if (part.type === "audio") {
+			const mime = typeof part.mimeType === "string" ? part.mimeType : "unknown MIME type";
+			out.push(text(`MCP audio content (${mime}) is not supported by this client.`));
+		} else {
+			// Resource links and future content forms retain all their metadata.
+			out.push(text(json(part)));
+		}
+	}
+	return out;
+}
+
+function toolResult(raw: unknown): AgentToolResult<unknown> {
+	const result = asRecord(raw);
+	const content = convertContent(result.content);
+	if (content.length === 0 && result.structuredContent !== undefined) content.push(text(json(result.structuredContent)));
+	return {
+		content: content.length ? content : [text(json(result))],
+		details: result,
+		...(result.structuredContent !== undefined ? { structuredContent: result.structuredContent as never } : {}),
+		...(result.isError === true ? { isError: true } : {}),
+	};
+}
+
+function resourceResult(raw: unknown): AgentToolResult<unknown> {
+	const result = asRecord(raw);
+	const contents = Array.isArray(result.contents) ? result.contents : [];
+	const content = contents.flatMap((entry) => {
+		const resource = asRecord(entry);
+		const label = `MCP resource${typeof resource.uri === "string" ? `: ${resource.uri}` : ""}`;
+		if (typeof resource.text === "string") return [text(`${label}\n${resource.text}`)];
+		if (typeof resource.blob === "string" && typeof resource.mimeType === "string" && resource.mimeType.startsWith("image/")) {
+			return [text(label), { type: "image" as const, data: resource.blob, mimeType: resource.mimeType }];
+		}
+		return [text(json(resource))];
+	});
+	return { content: content.length ? content : [text(json(result))], details: result };
+}
+
+function promptResult(raw: unknown): AgentToolResult<unknown> {
+	const result = asRecord(raw);
+	const messages = Array.isArray(result.messages) ? result.messages : [];
+	const content = messages.flatMap((entry) => {
+		const message = asRecord(entry);
+		const role = message.role === "assistant" ? "assistant" : "user";
+		const converted = convertContent([message.content]);
+		return [text(`MCP prompt message (${role})`), ...converted];
+	});
+	return { content: content.length ? content : [text(json(result))], details: result };
+}
+
+function normalizedToolPart(name: string): string {
+	return name.replace(/[^A-Za-z0-9_-]+/g, "_").replace(/^_+|_+$/g, "") || "tool";
+}
+
+/** Providers commonly cap function names at 64 characters. Preserve readable
+ * prefixes and add a stable digest only when truncation is necessary. */
+export function mcpToolName(serverName: string, toolName: string): string {
+	const base = `mcp__${normalizeMcpServerName(serverName)}__${normalizedToolPart(toolName)}`;
+	if (base.length <= MAX_TOOL_NAME_LENGTH) return base;
+	const digest = createHash("sha256").update(base).digest("hex").slice(0, 8);
+	return `${base.slice(0, MAX_TOOL_NAME_LENGTH - 9)}_${digest}`;
+}
+
+async function listAll<T>(
+	list: (cursor?: string) => Promise<McpRecord>,
+	property: string,
+): Promise<T[]> {
+	const out: T[] = [];
+	const seen = new Set<string>();
+	let cursor: string | undefined;
+	do {
+		const page = await list(cursor);
+		const values = page[property];
+		if (!Array.isArray(values)) throw new Error(`MCP response is missing ${property}`);
+		out.push(...values as T[]);
+		cursor = typeof page.nextCursor === "string" ? page.nextCursor : undefined;
+		if (cursor !== undefined && seen.has(cursor)) throw new Error(`MCP pagination repeated cursor ${cursor}`);
+		if (cursor !== undefined) seen.add(cursor);
+	} while (cursor !== undefined);
+	return out;
+}
+
+async function connectOne(server: McpServerSettings, credentials: McpCredentialSettings): Promise<McpConnection> {
+	const client = new Client({ name: "learnharness", version: "1" });
+	const transport = server.transport === "http"
+		? new StreamableHTTPClientTransport(new URL(server.url!), {
+			requestInit: { headers: credentials.headers ?? {} },
+		})
+		: new StdioClientTransport({
+			command: server.command!,
+			args: server.args ?? [],
+			...(server.cwd ? { cwd: server.cwd } : {}),
+			env: { ...getDefaultEnvironment(), ...credentials.env },
+			stderr: "inherit",
+		});
+	try {
+		await client.connect(transport, { timeout: MCP_CONNECT_TIMEOUT_MS, maxTotalTimeout: MCP_CONNECT_TIMEOUT_MS });
+		const capabilities = client.getServerCapabilities() ?? {};
+		const tools = capabilities.tools
+			? await listAll<McpTool>((cursor) => client.listTools(cursor ? { cursor } : undefined, requestOptions()) as Promise<McpRecord>, "tools")
+			: [];
+		const resources = capabilities.resources
+			? await listAll<McpRecord>((cursor) => client.listResources(cursor ? { cursor } : undefined, requestOptions()) as Promise<McpRecord>, "resources")
+			: [];
+		const resourceTemplates = capabilities.resources
+			? await listAll<McpRecord>((cursor) => client.listResourceTemplates(cursor ? { cursor } : undefined, requestOptions()) as Promise<McpRecord>, "resourceTemplates")
+			: [];
+		const prompts = capabilities.prompts
+			? await listAll<McpRecord>((cursor) => client.listPrompts(cursor ? { cursor } : undefined, requestOptions()) as Promise<McpRecord>, "prompts")
+			: [];
+		return {
+			server,
+			client,
+			tools,
+			resourceCount: resources.length,
+			resourceTemplateCount: resourceTemplates.length,
+			promptCount: prompts.length,
+		};
+	} catch (error) {
+		await client.close().catch(() => {});
+		throw new McpConnectionError(server.name, error);
+	}
+}
+
+function connectionFor(connections: McpConnection[], name: string): McpConnection {
+	const connection = connections.find((candidate) => candidate.server.name === name);
+	if (!connection) throw new Error(`MCP server "${name}" is not connected`);
+	return connection;
+}
+
+function serverNameSchema(connections: McpConnection[]) {
+	return Type.Union(connections.map((connection) => Type.Literal(connection.server.name)), {
+		description: "The configured MCP server name",
+	});
+}
+
+function sharedTools(connections: McpConnection[]): Record<string, AgentTool<any>> {
+	const tools: Record<string, AgentTool<any>> = {};
+	const resourceServers = connections.filter((connection) => connection.client.getServerCapabilities()?.resources);
+	const promptServers = connections.filter((connection) => connection.client.getServerCapabilities()?.prompts);
+	if (resourceServers.length) {
+		const listInput = Type.Object({ server: serverNameSchema(resourceServers), cursor: Type.Optional(Type.String()) });
+		tools.mcp_list_resources = {
+			name: "mcp_list_resources",
+			label: "List MCP resources",
+			description: "List resources exposed by a configured MCP server. Use nextCursor from the result as cursor for another page.",
+			parameters: listInput,
+			execute: serverExecute("mcp_list_resources", listInput, async (input, ctx) =>
+				connectionFor(resourceServers, input.server).client.listResources(input.cursor ? { cursor: input.cursor } : undefined, requestOptions(ctx.signal))),
+		};
+		tools.mcp_list_resource_templates = {
+			name: "mcp_list_resource_templates",
+			label: "List MCP resource templates",
+			description: "List parameterized resource URI templates exposed by a configured MCP server.",
+			parameters: listInput,
+			execute: serverExecute("mcp_list_resource_templates", listInput, async (input, ctx) =>
+				connectionFor(resourceServers, input.server).client.listResourceTemplates(input.cursor ? { cursor: input.cursor } : undefined, requestOptions(ctx.signal))),
+		};
+		const readInput = Type.Object({
+			server: serverNameSchema(resourceServers),
+			uri: Type.String({ description: "A resource URI from mcp_list_resources, or an expanded resource template URI" }),
+		});
+		tools.mcp_read_resource = {
+			name: "mcp_read_resource",
+			label: "Read MCP resource",
+			description: "Read a resource by URI from a configured MCP server.",
+			parameters: readInput,
+			execute: async (_id, rawInput, signal) => {
+				const input = rawInput as { server: string; uri: string };
+				return resourceResult(await connectionFor(resourceServers, input.server).client.readResource({ uri: input.uri }, requestOptions(signal)));
+			},
+		};
+	}
+	if (promptServers.length) {
+		const listInput = Type.Object({ server: serverNameSchema(promptServers), cursor: Type.Optional(Type.String()) });
+		tools.mcp_list_prompts = {
+			name: "mcp_list_prompts",
+			label: "List MCP prompts",
+			description: "List reusable prompts exposed by a configured MCP server, including their argument descriptions.",
+			parameters: listInput,
+			execute: serverExecute("mcp_list_prompts", listInput, async (input, ctx) =>
+				connectionFor(promptServers, input.server).client.listPrompts(input.cursor ? { cursor: input.cursor } : undefined, requestOptions(ctx.signal))),
+		};
+		const getInput = Type.Object({
+			server: serverNameSchema(promptServers),
+			name: Type.String({ description: "Prompt name from mcp_list_prompts" }),
+			arguments: Type.Optional(Type.Record(Type.String(), Type.String(), { description: "Prompt argument values; all MCP prompt arguments are strings" })),
+		});
+		tools.mcp_get_prompt = {
+			name: "mcp_get_prompt",
+			label: "Get MCP prompt",
+			description: "Resolve a reusable MCP prompt with optional string arguments and return its messages.",
+			parameters: getInput,
+			execute: async (_id, rawInput, signal) => {
+				const input = rawInput as { server: string; name: string; arguments?: Record<string, string> };
+				return promptResult(await connectionFor(promptServers, input.server).client.getPrompt({
+					name: input.name,
+					...(input.arguments ? { arguments: input.arguments } : {}),
+				}, requestOptions(signal)));
+			},
+		};
+	}
+	return tools;
+}
+
+function agentTools(connections: McpConnection[]): Record<string, AgentTool<any>> {
+	const tools = sharedTools(connections);
+	for (const connection of connections) {
+		for (const remote of connection.tools) {
+			const name = mcpToolName(connection.server.name, remote.name);
+			if (tools[name]) throw new Error(`MCP tool name collision: ${name}`);
+			const parameters = Type.Unsafe({ ...remote.inputSchema }) as TSchema;
+			const tool: AgentTool<any> = {
+				name,
+				label: `${connection.server.name}: ${remote.title ?? remote.name}`,
+				description: remote.description ?? `Call the ${remote.name} tool on the ${connection.server.name} MCP server.`,
+				parameters,
+				...(remote.outputSchema ? { outputSchema: Type.Unsafe({ ...remote.outputSchema }) as TSchema } : {}),
+				execute: async (_id, input, signal) => toolResult(await connection.client.callTool({
+					name: remote.name,
+					arguments: asRecord(input),
+				}, undefined, requestOptions(signal))),
+			};
+			tools[name] = withArgumentHeal(tool);
+		}
+	}
+	return tools;
+}
+
+/** Connect a snapshot of enabled servers. No store reads happen here; the
+ * server composition root supplies settings and credentials explicitly. */
+export async function connectMcpServers(
+	servers: McpServerSettings[],
+	credentials: Record<string, McpCredentialSettings> = {},
+): Promise<McpSession> {
+	const connections: McpConnection[] = [];
+	let tools: Record<string, AgentTool<any>> = {};
+	let closePromise: Promise<void> | undefined;
+	const close = () => {
+		closePromise ??= Promise.all(connections.map(async (connection) => {
+			await connection.client.close();
+		})).then(() => {});
+		return closePromise;
+	};
+	try {
+		for (const server of servers.filter((candidate) => candidate.enabled)) {
+			connections.push(await connectOne(server, credentials[server.id] ?? {}));
+		}
+		tools = agentTools(connections);
+	} catch (error) {
+		await close().catch(() => {});
+		throw error;
+	}
+	return {
+		tools,
+		connections,
+		summaries: () => connections.map((connection) => ({
+			id: connection.server.id,
+			name: connection.server.name,
+			tools: connection.tools.length,
+			resources: connection.resourceCount,
+			resourceTemplates: connection.resourceTemplateCount,
+			prompts: connection.promptCount,
+		})),
+		close,
+	};
+}
