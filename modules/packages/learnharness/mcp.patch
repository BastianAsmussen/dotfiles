+import React from "react";
+(globalThis as Record<string, unknown>).React = React;
+
+import assert from "node:assert/strict";
+import test from "node:test";
+import { renderToStaticMarkup } from "react-dom/server";
+import { McpSection, mcpCredentialPatch } from "../components/settings/mcp-section.tsx";
+import { artifactRendererFor } from "../components/artifacts/index.ts";
+import { ToolCallCard } from "../components/artifacts/tool-call-card.tsx";
+
+const servers = [
+	{ id: "covenant_1", name: "Covenant", enabled: true, transport: "http" as const, url: "https://covenantofearth.org/mcp" },
+	{ id: "local_server", name: "Local", enabled: false, transport: "stdio" as const, command: "node", args: ["server.mjs"] },
+];
+
+test("MCP settings render servers without exposing credential values", () => {
+	const html = renderToStaticMarkup(<McpSection mcp={{ servers }} onSave={async () => true} />);
+	assert.ok(html.includes("Covenant"));
+	assert.ok(html.includes("https://covenantofearth.org/mcp"));
+	assert.ok(html.includes("Local"));
+	assert.ok(html.includes("Test connection"));
+	assert.ok(html.includes("Add MCP server"));
+	assert.ok(!html.includes("password"));
+});
+
+test("credential patches preserve blank saved values and explicitly delete removed rows", () => {
+	const patch = mcpCredentialPatch([
+		{ name: "Authorization", value: "", saved: true },
+		{ name: "X-New", value: "secret", saved: false },
+	], ["Authorization", "X-Remove"]);
+	assert.deepEqual(patch, { headers: { "X-Remove": null, "X-New": "secret" }, env: {} });
+});
+
+test("dynamic MCP calls use the generic tool card without changing other fallbacks", () => {
+	assert.equal(artifactRendererFor("mcp__Covenant__search"), ToolCallCard);
+	assert.equal(artifactRendererFor("mcp_read_resource"), ToolCallCard);
+	assert.equal(artifactRendererFor("unregistered"), undefined);
+});
diff --git a/tests/mcp-settings.test.ts b/tests/mcp-settings.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6d2727add76491298f8effdbdc714f24faeb505d
--- /dev/null
+++ b/tests/mcp-settings.test.ts
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { normalizeMcpServerName, sanitizeMcpSettings } from "../src/core/mcp.ts";
+import { sanitizeUserSettings } from "../src/core/settings.ts";
+import { resolveSettings } from "../src/core/settings-resolution.ts";
+import { parseMcpSettingsBody } from "../src/server/settings-body.ts";
+
+const stdio = {
+	id: "server_stdio_1",
+	name: "Local tools",
+	enabled: true,
+	transport: "stdio",
+	command: "node",
+	args: ["server.mjs", "--safe"],
+	cwd: "/tmp",
+};
+const http = {
+	id: "server_http_1",
+	name: "Covenant",
+	enabled: true,
+	transport: "http",
+	url: "https://covenantofearth.org/mcp",
+};
+
+test("MCP settings parse both transports without credential fields", () => {
+	const parsed = parseMcpSettingsBody({ servers: [stdio, http] });
+	assert.ok(parsed.ok);
+	assert.equal(parsed.settings.servers?.length, 2);
+	assert.equal(parsed.settings.servers?.[1]?.url, "https://covenantofearth.org/mcp");
+	assert.ok(!("headers" in http));
+	assert.ok(!("env" in stdio));
+});
+
+test("MCP settings reject duplicate normalized names and mixed transports", () => {
+	const duplicate = parseMcpSettingsBody({ servers: [stdio, { ...http, id: "other_http_1", name: "Local tools!" }] });
+	assert.ok(!duplicate.ok);
+	assert.match(duplicate.error, /normalized names/);
+	const mixed = parseMcpSettingsBody({ servers: [{ ...stdio, url: "https://example.test/mcp" }] });
+	assert.ok(!mixed.ok);
+	assert.match(mixed.error, /only valid for HTTP/);
+});
+
+test("MCP settings reject URL credentials and malformed stdio arguments", () => {
+	const credentialUrl = parseMcpSettingsBody({ servers: [{ ...http, url: "https://user:secret@example.test/mcp" }] });
+	assert.ok(!credentialUrl.ok);
+	const args = parseMcpSettingsBody({ servers: [{ ...stdio, args: ["ok", 42] }] });
+	assert.ok(!args.ok);
+	assert.match(args.error, /array of strings/);
+});
+
+test("MCP disk sanitization drops malformed and ambiguous entries", () => {
+	const cleaned = sanitizeMcpSettings({
+		servers: [stdio, { ...http, id: stdio.id }, { ...http, id: "bad id" }, null],
+	});
+	assert.deepEqual(cleaned.servers?.map((server) => server.id), [stdio.id]);
+	assert.equal(normalizeMcpServerName("My local server"), "My_local_server");
+});
+
+test("user settings retain MCP configuration and resolution defaults to no servers", () => {
+	assert.deepEqual(resolveSettings(null).mcp, { servers: [] });
+	const record = sanitizeUserSettings({ version: 1, mcp: { servers: [http] } });
+	assert.equal(record?.mcp?.servers?.[0]?.name, "Covenant");
+	assert.deepEqual(resolveSettings(record).mcp.servers.map((server) => server.id), [http.id]);
+});
