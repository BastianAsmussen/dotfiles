@@ -0,0 +1,92 @@
+/** User-configurable Model Context Protocol servers. This module is pure and
+ * browser-safe: credential values never belong in this settings shape. */
+
+export interface McpServerSettings {
+	/** Stable credential/runtime identity; display renames do not change it. */
+	id: string;
+	name: string;
+	enabled: boolean;
+	transport: "stdio" | "http";
+	/** stdio only. Spawned directly, never interpolated into a shell command. */
+	command?: string;
+	args?: string[];
+	cwd?: string;
+	/** Streamable HTTP only. Static headers live in the private auth store. */
+	url?: string;
+}
+
+export interface McpSettings {
+	servers?: McpServerSettings[];
+}
+
+export interface McpCredentialSettings {
+	headers?: Record<string, string>;
+	env?: Record<string, string>;
+}
+
+export const MCP_SERVER_ID_PATTERN = /^[A-Za-z0-9_-]{8,64}$/;
+
+/** Provider-safe namespace fragment. Uniqueness is validated separately. */
+export function normalizeMcpServerName(name: string): string {
+	return name.trim().replace(/[^A-Za-z0-9_-]+/g, "_").replace(/^_+|_+$/g, "") || "server";
+}
+
+/** Accept only absolute HTTP(S) URLs without URL-embedded credentials. */
+export function normalizeMcpHttpUrl(raw: string): string {
+	try {
+		const url = new URL(raw.trim());
+		if ((url.protocol !== "http:" && url.protocol !== "https:") || url.username || url.password) return "";
+		return url.toString();
+	} catch {
+		return "";
+	}
+}
+
+function stringArray(raw: unknown): string[] | undefined {
+	if (!Array.isArray(raw) || raw.some((value) => typeof value !== "string")) return undefined;
+	return [...raw];
+}
+
+/** Lenient disk/read projection. Invalid entries drop; duplicates never make
+ * runtime tool namespaces ambiguous. The settings PUT parser is strict. */
+export function sanitizeMcpSettings(raw: unknown): McpSettings {
+	if (raw === null || typeof raw !== "object" || Array.isArray(raw)) return {};
+	const serversRaw = (raw as Record<string, unknown>).servers;
+	if (!Array.isArray(serversRaw)) return {};
+	const servers: McpServerSettings[] = [];
+	const ids = new Set<string>();
+	const names = new Set<string>();
+	for (const entry of serversRaw) {
+		if (entry === null || typeof entry !== "object" || Array.isArray(entry)) continue;
+		const value = entry as Record<string, unknown>;
+		if (typeof value.id !== "string" || !MCP_SERVER_ID_PATTERN.test(value.id)) continue;
+		if (typeof value.name !== "string" || !value.name.trim()) continue;
+		const name = value.name.trim();
+		const normalized = normalizeMcpServerName(name);
+		if (ids.has(value.id) || names.has(normalized)) continue;
+		if (value.transport !== "stdio" && value.transport !== "http") continue;
+		const server: McpServerSettings = {
+			id: value.id,
+			name,
+			enabled: typeof value.enabled === "boolean" ? value.enabled : true,
+			transport: value.transport,
+		};
+		if (value.transport === "stdio") {
+			if (typeof value.command !== "string" || !value.command.trim()) continue;
+			server.command = value.command.trim();
+			const args = value.args === undefined ? [] : stringArray(value.args);
+			if (args === undefined) continue;
+			server.args = args;
+			if (typeof value.cwd === "string" && value.cwd.trim()) server.cwd = value.cwd.trim();
+		} else {
+			if (typeof value.url !== "string") continue;
+			const url = normalizeMcpHttpUrl(value.url);
+			if (!url) continue;
+			server.url = url;
+		}
+		ids.add(server.id);
+		names.add(normalized);
+		servers.push(server);
+	}
+	return { servers };
+}
