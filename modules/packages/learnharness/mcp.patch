+import assert from "node:assert/strict";
+import test from "node:test";
+import { Type } from "typebox";
+import { createFauxCore } from "@earendil-works/pi-ai";
+import { createPracticeAgent, createProberAgent, createTeacherAgent } from "../src/agent/teacher-agent.ts";
+import type { PiEngine } from "../src/agent/models.ts";
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import type { JobStore } from "../src/core/ports.ts";
+
+function engine(): PiEngine {
+	const faux = createFauxCore({});
+	return { model: faux.getModel(), streamFn: faux.streamSimple };
+}
+
+const externalInput = Type.Object({});
+const external: AgentTool<typeof externalInput> = {
+	name: "mcp__Fixture__echo",
+	label: "Fixture echo",
+	description: "Synthetic MCP tool",
+	parameters: externalInput,
+	execute: async () => ({ content: [], details: null }),
+};
+
+const record = { messages: [], kind: undefined };
+const chatStore = { getChat: () => record };
+
+test("additional MCP tools reach prober, teacher and practice", () => {
+	const prober = createProberAgent({
+		chatId: "chat",
+		chatStore: chatStore as never,
+		deliver: () => {},
+		jobStore: {} as JobStore,
+		spawn: () => {},
+	}, { engine: engine(), additionalTools: { [external.name]: external } });
+	const teacher = createTeacherAgent(undefined, { engine: engine(), additionalTools: { [external.name]: external } });
+	const practice = createPracticeAgent({ chatId: "chat", chatStore }, { engine: engine(), additionalTools: { [external.name]: external } });
+	for (const agent of [prober, teacher, practice]) {
+		assert.ok(agent.state.tools.some((tool) => tool.name === external.name));
+	}
+});
+
+test("additional tool collisions with built-ins fail before inference", () => {
+	assert.throws(() => createTeacherAgent(undefined, {
+		engine: engine(),
+		additionalTools: { quiz: { ...external, name: "quiz" } as AgentTool<any> },
+	}), /Duplicate agent tool name: quiz/);
+});
