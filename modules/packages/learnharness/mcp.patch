+++ b/tests/mcp-client.test.ts
@@ -0,0 +1,112 @@
+import assert from "node:assert/strict";
+import http from "node:http";
+import type { AddressInfo } from "node:net";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
+import { Value } from "typebox/value";
+import { connectMcpServers, McpConnectionError, type McpSession } from "../src/agent/mcp.ts";
+import type { McpServerSettings } from "../src/core/mcp.ts";
+import { createMcpFixtureServer } from "./helpers/mcp-fixture.ts";
+
+const FIXTURE = fileURLToPath(new URL("./fixtures/mcp/server.mjs", import.meta.url));
+
+async function exercise(session: McpSession, abort = false, expectedToken = "synthetic-token") {
+	assert.deepEqual(session.summaries(), [{ id: "fixture_1", name: "Fixture", tools: 4, resources: 1, resourceTemplates: 1, prompts: 1 }]);
+	assert.ok(session.tools.mcp__Fixture__echo);
+	assert.ok(session.tools.mcp_list_resources);
+	assert.ok(session.tools.mcp_list_resource_templates);
+	assert.ok(session.tools.mcp_read_resource);
+	assert.ok(session.tools.mcp_list_prompts);
+	assert.ok(session.tools.mcp_get_prompt);
+
+	const echo = session.tools.mcp__Fixture__echo!;
+	assert.ok(Value.Check(echo.parameters, { message: "hello" }));
+	assert.ok(!Value.Check(echo.parameters, { message: "" }));
+	const result = await echo.execute("call", { message: "hello" });
+	assert.equal(result.content[0]?.type, "text");
+	assert.equal((result.content[0] as { text: string }).text, `hello:${expectedToken}`);
+	assert.deepEqual(result.structuredContent, { echoed: "hello" });
+
+	const image = await session.tools.mcp__Fixture__image!.execute("image", {});
+	assert.equal(image.content[0]?.type, "image");
+	const failure = await session.tools.mcp__Fixture__failure!.execute("failure", {});
+	assert.equal(failure.isError, true);
+
+	const resources = await session.tools.mcp_list_resources!.execute("resources", { server: "Fixture" });
+	assert.match((resources.content[0] as { text: string }).text, /fixture:\/\/note/);
+	const templates = await session.tools.mcp_list_resource_templates!.execute("templates", { server: "Fixture" });
+	assert.match((templates.content[0] as { text: string }).text, /fixture:\/\/notes/);
+	const resource = await session.tools.mcp_read_resource!.execute("read", { server: "Fixture", uri: "fixture://note" });
+	assert.match((resource.content[0] as { text: string }).text, /Contents for fixture:\/\/note/);
+
+	const prompts = await session.tools.mcp_list_prompts!.execute("prompts", { server: "Fixture" });
+	assert.match((prompts.content[0] as { text: string }).text, /greeting/);
+	const prompt = await session.tools.mcp_get_prompt!.execute("prompt", { server: "Fixture", name: "greeting", arguments: { name: "learner" } });
+	assert.match(prompt.content.map((part) => part.type === "text" ? part.text : "").join("\n"), /Hello learner/);
+
+	if (abort) {
+		const controller = new AbortController();
+		const pending = session.tools.mcp__Fixture__slow!.execute("slow", {}, controller.signal);
+		controller.abort();
+		await assert.rejects(pending);
+	}
+}
+
+test("stdio MCP discovery, schemas, calls, resources, prompts, abort and cleanup", async () => {
+	const server: McpServerSettings = {
+		id: "fixture_1",
+		name: "Fixture",
+		enabled: true,
+		transport: "stdio",
+		command: process.execPath,
+		args: [FIXTURE],
+	};
+	const session = await connectMcpServers([server], { fixture_1: { env: { MCP_FIXTURE_TOKEN: "synthetic-token" } } });
+	try { await exercise(session, true); }
+	finally { await session.close(); }
+	await session.close();
+});
+
+test("Streamable HTTP MCP passes static headers and supports every capability", async () => {
+	const mcpServer = createMcpFixtureServer();
+	const transport = new StreamableHTTPServerTransport({ sessionIdGenerator: () => crypto.randomUUID() });
+	await mcpServer.connect(transport);
+	const httpServer = http.createServer((request, response) => {
+		if (request.headers["x-fixture-token"] !== "synthetic-token") {
+			response.writeHead(401).end();
+			return;
+		}
+		void transport.handleRequest(request, response).catch((error) => {
+			console.error("MCP HTTP fixture request failed", error);
+			if (!response.headersSent) response.writeHead(500);
+			response.end();
+		});
+	});
+	await new Promise<void>((resolve) => httpServer.listen(0, "127.0.0.1", resolve));
+	const address = httpServer.address() as AddressInfo;
+	const server: McpServerSettings = {
+		id: "fixture_1",
+		name: "Fixture",
+		enabled: true,
+		transport: "http",
+		url: `http://127.0.0.1:${address.port}/mcp`,
+	};
+	const session = await connectMcpServers([server], { fixture_1: { headers: { "X-Fixture-Token": "synthetic-token" } } });
+	try { await exercise(session, false, "missing"); }
+	finally {
+		await session.close();
+		await mcpServer.close();
+		httpServer.closeAllConnections();
+		await new Promise<void>((resolve, reject) => httpServer.close((error) => error ? reject(error) : resolve()));
+	}
+});
+
+test("disabled servers do not connect and unavailable enabled servers fail clearly", async () => {
+	const disabled: McpServerSettings = { id: "disabled_1", name: "Disabled", enabled: false, transport: "http", url: "http://127.0.0.1:1/mcp" };
+	const empty = await connectMcpServers([disabled]);
+	assert.deepEqual(empty.summaries(), []);
+	assert.deepEqual(Object.keys(empty.tools), []);
+	await empty.close();
+	await assert.rejects(connectMcpServers([{ ...disabled, enabled: true }]), McpConnectionError);
+});
