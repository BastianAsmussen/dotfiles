@@ -0,0 +1,103 @@
+import OPERATING_POLICY from '../../../../../prompts/operator-policy.md?raw';
+
+const PROVIDER_PROMPT_MARKERS: Record<string, readonly string[]> = {
+  kimi: [
+    'You are Kimi, an AI assistant developed by Moonshot AI',
+    'Who You Are',
+    'Non-negotiables',
+    'You have a three-layer view of your identity',
+  ],
+  mistral: [
+    'You are Mistral',
+    'Mistral AI',
+    'mistral.ai',
+  ],
+} as const;
+
+const ALL_MARKERS = Object.values(PROVIDER_PROMPT_MARKERS).flat();
+
+export interface KimiPromptRewrite {
+  readonly payload: unknown;
+  readonly changed: boolean;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function replacementFor(value: unknown): string | undefined {
+  return typeof value === 'string' && ALL_MARKERS.some((marker) => value.includes(marker))
+    ? OPERATING_POLICY.trim()
+    : undefined;
+}
+
+function rewriteHolder(holder: Record<string, unknown>, key: string): boolean {
+  const direct = replacementFor(holder[key]);
+  if (direct !== undefined) {
+    holder[key] = direct;
+    return true;
+  }
+  const content = holder[key];
+  if (!Array.isArray(content)) return false;
+  let changed = false;
+  for (const block of content) {
+    if (!isRecord(block)) continue;
+    const replacement = replacementFor(block['text']);
+    if (replacement === undefined) continue;
+    block['text'] = replacement;
+    changed = true;
+  }
+  return changed;
+}
+
+export function rewriteKimiPromptPayload(payload: unknown): KimiPromptRewrite {
+  if (!isRecord(payload)) return { payload, changed: false };
+  const rewritten = structuredClone(payload);
+  let changed = rewriteHolder(rewritten, 'system');
+  changed = rewriteHolder(rewritten, 'instructions') || changed;
+  for (const key of ['messages', 'input']) {
+    const messages = rewritten[key];
+    if (!Array.isArray(messages)) continue;
+    for (const message of messages) {
+      if (!isRecord(message) || (message['role'] !== 'system' && message['role'] !== 'developer')) {
+        continue;
+      }
+      changed = rewriteHolder(message, 'content') || changed;
+    }
+  }
+  
+  // If no system message exists and this looks like an OpenAI request, add one
+  if (!changed && Array.isArray(rewritten.messages)) {
+    const hasSystem = rewritten.messages.some((m: any) => m.role === 'system');
+    if (!hasSystem) {
+      rewritten.messages = [
+        { role: 'system', content: OPERATING_POLICY.trim() },
+        ...rewritten.messages,
+      ];
+      changed = true;
+    }
+  }
+  
+  return { payload: changed ? rewritten : payload, changed };
+}
+
+export const kimiPromptFetch: typeof fetch = async (input, init) => {
+  const request = input instanceof Request ? input : undefined;
+  const sourceBody = init?.body ?? (request === undefined ? undefined : await request.clone().text());
+  if (typeof sourceBody !== 'string') return globalThis.fetch(input, init);
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(sourceBody);
+  } catch {
+    return globalThis.fetch(input, init);
+  }
+  const { payload, changed } = rewriteKimiPromptPayload(parsed);
+  if (!changed) return globalThis.fetch(input, init);
+  const body = JSON.stringify(payload);
+  if (request !== undefined && init?.body === undefined) {
+    const headers = new Headers(init?.headers ?? request.headers);
+    headers.delete('content-length');
+    return globalThis.fetch(new Request(request, { ...init, body, headers }));
+  }
+  return globalThis.fetch(input, { ...init, body });
+};
